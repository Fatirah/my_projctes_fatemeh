#پروژه تعیین سن بر اساس ماه و روز و ساعت و ثانیه
import time#وارد کردن ماژول زمان 
from calendar import isleap#یک ماژول برای کار با تقویم و سالهاست که بررسی میکند آیا سال کبیسه است یا نه 

def judge_leap_year(year):#تعریف تابع بررسی سال کبیسه که سال را دریافت میکند و بررسی میکند سال کبیسه است یا نه
    if isleap(year):#بررسی میکند که سال کبیسه است یا نه اگر بود 
        return True #بر میگرداند 
    else:#در غیر اینصورت اگر سال کبیسه نبود 
        return False #بر میگرداند 
    
def month_days(month,leap_year):#معرفی تابع برای مشخص کردن تعداد روزهای یک ماه با بررسی سال کبیسه 
    if month in [1,3,5,7,8,10,12]:#اگر ماه ها جز ژانویه و مارس و می و آگوست و اکتبر و دسامبر بود 
        return 31 #31 روزه هستند 
    elif month in [4,6,9,11]:#اگر جز ماه های آوریل و ژوِن و سپتامبر و نوامبر بود 
        return 30#30روزه هستند
    elif month==2 and leap_year:#اگر ماه فوریه بود و سال کبیسه بود 
        return 29#29 روز دارد 
    elif month==2 and (not leap_year):#اگر ماه فوریه بود و سال کبیسه نبود
        return 28#28 روز دارد 
    
def to_hours(days):#تبدیل روز به ساعت 
    hours=days*24#تبدیل روز به ساعت 
    return hours#ساعت ر ا بر میگرداند 

def to_seconds(days):#تبدیل روز به ثانیه 
    sec=days*24*3600#تبدیل روز به ثانیه 
    return sec#ثانیه را بر میگرداند 

age=input("Enter your age: ")#سن را وارد کنید 

localtime=time.localtime(time.time())#این خط عدد را تبدیل میکند به ساختار زمان محلی یعنی سال ماه روز ساعت ثانیه 

year=int(age)#این خط مقدار سن را به عدد صحیح تبدیل کرده و در متغیر سال ذخیره میکند 

month=year*12 + localtime.tm_mon#تبدیل سال به ماه هر سال 12 ماه دارد به علاوه زمان فعلی رو سیستم میشود 

day=0#مقدار اولیه روز 

begin_year=int(localtime.tm_year) - year #سال تولد را محاسبه میکند یعنی سال سیستم را دریافت میکند و منهای سن کاربر میکند و سال تولد را محاسبه میکند

end_year=begin_year+year#بدست آوردن سال سیستم 

for y in range(begin_year,end_year):#از سال شروع تا پایان حلقه میزند 
    if(judge_leap_year(y)):#بررسی میکند سال کبیسه است یا نه 
        day=day+366#اگه سال کبیسه باشد 366 روز دارد 
    else:
        day=day+365#در غیر اینصورت 365 روز دارد 
        
leap_year=judge_leap_year(localtime.tm_year)#سال فعلی سیستم را میگیرد و بررسی میکند سال کبیسه است یا نه

for m in range(1,localtime.tm_mon):#این حلقه از ماه تا یک ماه قبل از ماه فعلی اجرا میکند 
    day=day+month_days(m,leap_year)#اینجا تعداد روزهای هر ماه به متغیر day اضافه میکند 
day=day+localtime.tm_mday#شماره روز در ماه را به علاوه day میکند 
hours=to_hours(day)#تبدیل روز به ساعت
seconds=to_seconds(day)#تبدیل روز به ثانیه 

print(" age is %d years and " % (year),end="")#چاپ عبارت 
print("%d months and %d days" %(month,day),end="")
print(" and %d hours and %d seconds "%(hours,seconds))
